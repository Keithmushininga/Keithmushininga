","        )\n","\n","        info = float(\n","            G_Z\n","            @ S0inv\n","            @ G_Z\n","        )\n","\n","        if info <= 1e-15:\n","            raise RuntimeError(\n","                f\"Degenerate scalar novel-state information at frame {t}.\"\n","            )\n","\n","        y = float(\n","            G_Z\n","            @ S0inv\n","            @ (\n","                residual-D_Z\n","            )\n","            / info\n","        )\n","\n","        Rscalar = float(\n","            1.0/info\n","        )\n","\n","        # Novel-state prior.\n","        z_pred = float(\n","            rho*z_prev\n","        )\n","\n","        Pz_pred = float(\n","            rho*rho*Pz_prev\n","            + q\n","        )\n","\n","        # Persistent two-model prior probability.\n","        pi_prior = float(\n","            p05*(\n","                1.0-pi_prev\n","            )\n","            + (\n","                1.0-p50\n","            )*pi_prev\n","        )\n","\n","        pi_prior = float(\n","            np.clip(\n","                pi_prior,\n","                CFG.probability_eps,\n","                1.0-CFG.probability_eps\n","            )\n","        )\n","\n","        # M0: frozen base model.\n","        mean0 = np.zeros(\n","            m_obs\n","        )\n","\n","        cov0 = S0\n","\n","        # M5: rank-growth predictive model.\n","        mean5 = (\n","            D_Z\n","            + G_Z*z_pred\n","        )\n","\n","        cov5 = (\n","            S0\n","            + Pz_pred\n","            * np.outer(\n","                G_Z,\n","                G_Z\n","            )\n","        )\n","\n","        l0 = gaussian_logpdf(\n","            residual,\n","            mean0,\n","            cov0,\n","        )\n","\n","        l5 = gaussian_logpdf(\n","            residual,\n","            mean5,\n","            cov5,\n","        )\n","\n","        logbf = float(\n","            l5-l0\n","        )\n","\n","        logodds = float(\n","            stable_logit(\n","                pi_prior\n","            )\n","            + logbf\n","        )\n","\n","        pi_post = stable_logistic(\n","            logodds\n","        )\n","\n","        # Scalar conditional M5 update.\n","        Sscalar = float(\n","            Pz_pred\n","            + Rscalar\n","        )\n","\n","        Kgain = float(\n","            Pz_pred\n","            / Sscalar\n","        )\n","\n","        z_post = float(\n","            z_pred\n","            + Kgain*(\n","                y-z_pred\n","            )\n","        )\n","\n","        Pz_post = float(\n","            max(\n","                (\n","                    1.0-Kgain\n","                )*Pz_pred,\n","                1e-12\n","            )\n","        )\n","\n","        z_pred_arr[j] = z_pred\n","        Pz_pred_arr[j] = Pz_pred\n","        z_filt_arr[j] = z_post\n","        Pz_filt_arr[j] = Pz_post\n","\n","        scalar_y_arr[j] = y\n","        scalar_R_arr[j] = Rscalar\n","        scalar_info_arr[j] = info\n","\n","        l0_arr[j] = l0\n","        l5_arr[j] = l5\n","        logbf_arr[j] = logbf\n","        logodds_arr[j] = logodds\n","        pi_arr[j] = pi_post\n","\n","        z_prev = z_post\n","        Pz_prev = Pz_post\n","        pi_prev = pi_post\n","\n","    return {\n","        \"start_frame\": start_frame,\n","        \"z_pred\": z_pred_arr,\n","        \"Pz_pred\": Pz_pred_arr,\n","        \"z_filt\": z_filt_arr,\n","        \"Pz_filt\": Pz_filt_arr,\n","        \"scalar_y\": scalar_y_arr,\n","        \"scalar_R\": scalar_R_arr,\n","        \"scalar_info\": scalar_info_arr,\n","        \"loglik_M0\": l0_arr,\n","        \"loglik_M5\": l5_arr,\n","        \"logBF\": logbf_arr,\n","        \"posterior_logodds\": logodds_arr,\n","        \"posterior_probability_M5\": pi_arr,\n","    }\n","\n","\n","def future_z_moments(\n","    z_filt,\n","    Pz_filt,\n","    h,\n","):\n","    rho = float(\n","        CFG.rank_growth_rho\n",