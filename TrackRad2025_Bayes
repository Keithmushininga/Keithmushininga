\n","   relative_stationary_covariance_error  \n","0                          5.259635e-15  "]},"metadata":{},"output_type":"display_data"}],"source":["D_MODEL = pod_models[\"D\"]\n","\n","D_REAL_MEAN = D_MODEL[\"mean\"].astype(float)\n","PHI_REAL = D_MODEL[\"modes\"].astype(float)\n","SCORES_REAL = D_MODEL[\"scores\"].astype(float)\n","\n","NPIX = H * W\n","ROI_PIXEL_MASK = reference_mask.astype(bool)\n","ROI_FLAT = ROI_PIXEL_MASK.reshape(-1)\n","\n","SIGMA_A = np.atleast_2d(\n","    np.cov(\n","        SCORES_REAL[FIT].T,\n","        ddof=1\n","    )\n",")\n","SIGMA_A = 0.5*(SIGMA_A + SIGMA_A.T)\n","\n","X0 = SCORES_REAL[FIT[:-1]]\n","X1 = SCORES_REAL[FIT[1:]]\n","\n","F0_GEN = np.linalg.solve(\n","    X0.T @ X0 + 1e-5*np.eye(K),\n","    X0.T @ X1\n",").T\n","\n","rho_F0 = float(\n","    np.max(\n","        np.abs(\n","            np.linalg.eigvals(F0_GEN)\n","        )\n","    )\n",")\n","\n","gamma_cap = min(\n","    1.0,\n","    CFG.stationary_generator_rho_max\n","    / max(rho_F0, 1e-12)\n",")\n","\n","chosen = None\n","\n","for gamma in np.linspace(\n","    gamma_cap,\n","    0.0,\n","    2001\n","):\n","    F_try = gamma*F0_GEN\n","\n","    Q_try = (\n","        SIGMA_A\n","        - F_try @ SIGMA_A @ F_try.T\n","    )\n","    Q_try = 0.5*(Q_try+Q_try.T)\n","\n","    min_eig = float(\n","        np.min(\n","            np.linalg.eigvalsh(Q_try)\n","        )\n","    )\n","\n","    rho_try = float(\n","        np.max(\n","            np.abs(\n","                np.linalg.eigvals(F_try)\n","            )\n","        )\n","    )\n","\n","    if (\n","        rho_try <= CFG.stationary_generator_rho_max + 1e-12\n","        and min_eig >= -CFG.stationary_psd_tolerance\n","    ):\n","        chosen = (\n","            float(gamma),\n","            F_try,\n","            Q_try,\n","            min_eig,\n","            rho_try,\n","        )\n","        break\n","\n","if chosen is None:\n","    raise RuntimeError(\n","        \"Could not construct the frozen stationary generator.\"\n","    )\n","\n","GAMMA_GEN, F_GEN, Q_GEN, Q_GEN_MIN_EIG, RHO_F_GEN = chosen\n","\n","qe, qv = np.linalg.eigh(\n","    0.5*(Q_GEN+Q_GEN.T)\n",")\n","\n","qe = np.maximum(qe, 1e-10)\n","\n","Q_GEN = (\n","    qv @ np.diag(qe) @ qv.T\n",")\n","Q_GEN = 0.5*(Q_GEN+Q_GEN.T)\n","\n","SIGMA_STATIONARY_CHECK = solve_discrete_lyapunov(\n","    F_GEN,\n","    Q_GEN\n",")\n","\n","stationary_generator_audit = pd.DataFrame([{\n","    \"rho_F0_fit\": rho_F0,\n","    \"gamma_selected\": GAMMA_GEN,\n","    \"rho_F_gen\": RHO_F_GEN,\n","    \"Q_gen_min_eigenvalue_before_cleanup\": Q_GEN_MIN_EIG,\n","    \"relative_stationary_covariance_error\": float(\n","        np.linalg.norm(\n","            SIGMA_STATIONARY_CHECK-SIGMA_A,\n","            ord=\"fro\"\n","        )\n","        / max(\n","            np.linalg.norm(SIGMA_A, ord=\"fro\"),\n","            1e-12\n","        )\n","    ),\n","}])\n","\n","display(stationary_generator_audit)\n","\n","stationary_generator_audit.to_csv(\n","    TABLES / \"stationary_latent_generator_audit.csv\",\n","    index=False\n",")"]},{"cell_type":"markdown","id":"9fe4a7e3","metadata":{"papermill":{"duration":0.027108,"end_time":"2026-09-03T13:10:00.700391+00:00","exception":false,"start_time":"2026-09-03T13:10:00.673283+00:00","status":"completed"},"tags":[]},"source":["## 21. Frozen ROI-aware challenge directions"]},{"cell_type":"code","execution_count":28,"id":"b492e29c","metadata":{"execution":{"iopub.execute_input":"2026-09-03T13:10:00.756286Z","iopub.status.busy":"2026-09-03T13:10:00.755784Z","iopub.status.idle":"2026-09-03T13:10:00.796076Z","shell.execute_reply":"2026-09-03T13:10:00.794703Z"},"papermill":{"duration":0.070526,"end_time":"2026-09-03T13:10:00.79796+00:00","exception":false,"start_time":"2026-09-03T13:10:00.727434+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n"," 