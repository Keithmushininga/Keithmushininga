\n","        ),\n","        \"fit_rms_weighted_A\": fit_rms(\n","            lambda_a*A\n","        ),\n","    },\n","])\n","\n","display(\n","    feature_audit\n",")\n","\n","\n","derivative_audit = pd.DataFrame([{\n","    \"fit_rms_D\": fit_rms(\n","        D\n","    ),\n","    \"fit_rms_V\": fit_rms(\n","        V\n","    ),\n","    \"fit_rms_A\": fit_rms(\n","        A\n","    ),\n","    \"lambda_v\": float(\n","        lambda_v\n","    ),\n","    \"lambda_a\": float(\n","        lambda_a\n","    ),\n","    \"weighted_V_over_D_rms\": float(\n","        fit_rms(\n","            lambda_v*V\n","        )\n","        / max(\n","            fit_rms(\n","                D\n","            ),\n","            1e-12\n","        )\n","    ),\n","    \"weighted_A_over_D_rms\": float(\n","        fit_rms(\n","            lambda_a*A\n","        )\n","        / max(\n","            fit_rms(\n","                D\n","            ),\n","            1e-12\n","        )\n","    ),\n","    \"D_equals_V_numerically\": bool(\n","        np.allclose(\n","            D,\n","            V,\n","            rtol=1e-8,\n","            atol=1e-10,\n","        )\n","    ),\n","    \"D_equals_A_numerically\": bool(\n","        np.allclose(\n","            D,\n","            A,\n","            rtol=1e-8,\n","            atol=1e-10,\n","        )\n","    ),\n","    \"V_equals_A_numerically\": bool(\n","        np.allclose(\n","            V,\n","            A,\n","            rtol=1e-8,\n","            atol=1e-10,\n","        )\n","    ),\n","}])\n","\n","display(\n","    derivative_audit\n",")\n","\n","\n","def orthonormalize_columns(\n","    M,\n","    tolerance=1e-10,\n","):\n","    U, s, _ = np.linalg.svd(\n","        np.asarray(\n","            M,\n","            dtype=float\n","        ),\n","        full_matrices=False,\n","    )\n","\n","    if len(\n","        s\n","    ) == 0:\n","        return np.zeros(\n","            (\n","                M.shape[0],\n","                0\n","            )\n","        )\n","\n","    threshold = (\n","        tolerance\n","        * max(\n","            float(\n","                s[0]\n","            ),\n","            1.0\n","        )\n","    )\n","\n","    rank = int(\n","        np.sum(\n","            s > threshold\n","        )\n","    )\n","\n","    return U[\n","        :,\n","        :rank\n","    ]\n","\n","\n","D_ONLY_BASIS = (\n","    pod_models[\n","        \"D\"\n","    ][\n","        \"modes\"\n","    ][\n","        :D_DIM,\n","        :\n","    ]\n",")\n","\n","Q_D = orthonormalize_columns(\n","    D_ONLY_BASIS\n",")\n","\n","D_ONLY_FILTERED = (\n","    reconstructed_displacement[\n","        \"D\"\n","    ]\n",")\n","\n","subspace_rows = []\n","readout_consistency_rows = []\n","\n","for name in [\n","    \"D\",\n","    \"DV\",\n","    \"DA\",\n","    \"DVA\",\n","]:\n","    model = pod_models[\n","        name\n","    ]\n","\n","    U_D_block = (\n","        model[\n","            \"modes\"\n","        ][\n","            :D_DIM,\n","            :\n","        ]\n","    )\n","\n","    Q_R = orthonormalize_columns(\n","        U_D_block\n","    )\n","\n","    if (\n","        Q_D.shape[1] > 0\n","        and Q_R.shape[1] > 0\n","    ):\n","        singular = np.linalg.svd(\n","            Q_D.T\n","            @ Q_R,\n","            compute_uv=False,\n","        )\n","\n","        angles_deg = np.degrees(\n","            np.arccos(\n","                np.clip(\n","                    singular,\n","                    0.0,\n","                    1.0,\n","                )\n","            )\n","        )\n","    else:\n","        angles_deg = np.array([\n","            np.nan\n","        ])\n","\n","    # Explicit enriched displacement readout.\n","    explicit_Dhat = (\n","        model[\n","            \"mean\"\n","        ][\n","            :D_DIM\n","        ][\n","            None,\n","            :\n","        ]\n","        + kalman_runs[\n","            name\n","        ][\n","            \"filtered\"\n","        ]\n","        @ U_D_block.T\n","    )\n","\n","    implementation_Dhat = (\n","        reconstructed_displacement[\n","            name\n","        ]\n","    )\n","\n","    max_readout_abs_diff = float(\n","        np.max(\n","            np.abs(\n","                explicit_Dhat\n","                - implementation_Dhat\n","            )\n","        )\n","    )\n","\n","    relative_filtered_difference_vs_D = float(\n","        np.sqrt(\n","            np.mean(\n","                (\n","                    implementation_Dhat[\n","                        TEST\n","                    ]\n","                    - D_ONLY_FILTERED[\n","                        TEST\n","                    ]\n","                )**2\n","            )\n","        )\n","        / max(\n","            np.sqrt(\n","                np.mean(\n","                    D_ONLY_FILTERED[\n","                        TEST\n","                    ]**2\n","                )\n","            ),\n","            1e-12\n","        )\n","    )\n","\n","    subspace_rows.append({\n","        \"representation\": name,\n","        \"augmented_feature_dimension\": int(\n","            model[\n","                \"modes\"\n","            ].shape[0]\n","        ),\n","        \"displacement_readout_rows\": int(\n","            U_D_block.shape[0]\n","        ),\n","        \"displacement_block_rank\": int(\n","            np.linalg.matrix_rank(\n","                U_D_block\n","            )\n","        ),\n","        \"median_principal_angle_vs_D_deg\": float(\n","            np.nanmedian(\n","                angles_deg\n","            )\n","        ),\n","        \"max_principal_angle_vs_D_deg\": float(\n","            np.nanmax(\n","                angles_deg\n","            )\n","        ),\n","        \"relative_filtered_displacement_difference_vs_D\": (\n","            relative_filtered_difference_vs_D\n","        ),\n","    })\n","\n","    readout_consistency_rows.append({\n","        