,"), sub in real_observation_framewise.groupby([\n","    \"split\",\n","    \"method\",\n","]):\n","    true_med = float(\n","        sub[\n","            \"true_target_motion_mm\"\n","        ].median()\n","    )\n","\n","    pred_med = float(\n","        sub[\n","            \"predicted_target_motion_mm\"\n","        ].median()\n","    )\n","\n","    observation_summary_rows.append({\n","        \"split\": split_name,\n","        \"method\": method,\n","        \"median_true_target_motion_mm\": true_med,\n","        \"median_predicted_target_motion_mm\": pred_med,\n","        \"median_motion_capture_ratio\": safe_ratio(\n","            pred_med,\n","            true_med,\n","        ),\n","        \"median_dice\": float(\n","            sub[\n","                \"dice\"\n","            ].median()\n","        ),\n","        \"median_centroid_error_mm\": float(\n","            sub[\n","                \"centroid_error_mm\"\n","            ].median()\n","        ),\n","        \"median_hd95_mm\": float(\n","            sub[\n","                \"hd95_mm\"\n","            ].median()\n","        ),\n","        \"median_assd_mm\": float(\n","            sub[\n","                \"assd_mm\"\n","            ].median()\n","        ),\n","    })\n","\n","\n","real_observation_summary = pd.DataFrame(\n","    observation_summary_rows\n",")\n","\n","display(\n","    real_observation_summary\n",")\n","\n","single_test = real_observation_summary[\n","    (\n","        real_observation_summary[\n","            \"split\"\n","        ] == \"test\"\n","    )\n","    & (\n","        real_observation_summary[\n","            \"method\"\n","        ] == \"single_scale_HS\"\n","    )\n","].iloc[0]\n","\n","pyr_test = real_observation_summary[\n","    (\n","        real_observation_summary[\n","            \"split\"\n","        ] == \"test\"\n","    )\n","    & (\n","        real_observation_summary[\n","            \"method\"\n","        ] == \"pyramidal_HS\"\n","    )\n","].iloc[0]\n",