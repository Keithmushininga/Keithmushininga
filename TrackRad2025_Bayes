ax(\n","        sG[-1],\n","        1e-15\n","    )\n",")\n","\n","observability_singular_values = pd.DataFrame({\n","    \"index\": np.arange(\n","        1,\n","        K+1\n","    ),\n","    \"singular_value_G\": sG,\n","    \"singular_value_whitened\": sO,\n","    \"train_R2_observed_coordinate\": train_r2,\n","})\n","\n","observation_map_audit = pd.DataFrame([{\n","    \"rank_G\": rank_G,\n","    \"state_dimension\": K,\n","    \"condition_number_G\": cond_G,\n","    \"min_singular_G\": float(\n","        sG[-1]\n","    ),\n","    \"max_singular_G\": float(\n","        sG[0]\n","    ),\n","    \"min_whitened_information_singular\": float(\n","        sO[-1]\n","    ),\n","    \"median_whitened_information_singular\": float(\n","        np.median(sO)\n","    ),\n","    \"max_whitened_information_singular\": float(\n","        sO[0]\n","    ),\n","    \"median_train_R2\": float(\n","        np.median(\n","            train_r2\n","        )\n","    ),\n","}])\n","\n","display(\n","    observation_map_audit\n",")\n","\n","display(\n","    observability_singular_values\n",")\n","\n","observation_map_audit.to_csv(\n","    TABLES / \"observation_map_audit.csv\",\n","    index=False\n",")\n","\n","observability_singular_values.to_csv(\n","    TABLES / \"observation_map_singular_values.csv\",\n","    index=False\n",")"]},{"cell_type":"markdown","id":"84c674c9","metadata":{"papermill":{"duration":0.03255,"end_time":"2026-09-03T13:19:10.675762+00:00","exception":false,"start_time":"2026-09-03T13:19:10.643212+00:00","status":"completed"},"tags":[]},"source":["# Part J — Static inverse and latent Kalman filter\n","\n","Two observation-corrected estimators are compared.\n","\n","### Static Bayesian inverse\n","\n","\\[\n","\\hat a_t^{static}\n","=\n","\\Sigma_a G^T\n","(G\\Sigma_aG^T+R)^{-1}\n","(b_t-c).\n","\\]\n","\n","### Temporal latent filter\n","\n","\\[\n","a_{t+1}=F_{\\rm gen}a_t+w_t,\n","\\qquad\n","b_t=c+Ga_t+v_t.\n","\\]\n","\n","The temporal filter uses the stationary prior \\(a_0\\sim N(0,\\Sigma_a)\\)."]},{"cell_type":"markdown","id":"306d0589","metadata":{"papermill":{"duration":0.035546,"end_time":"2026-09-03T13:19:10.742792+00:00","exception":false,"start_time":"2026-09-03T13:19:10.707246+00:00","status":"completed"},"tags":[]},"source":["## 30. Static inverse"]},{"cell_type":"code","execution_count":37,"id":"004a8a6a","metadata":{"execution":{"iopub.execute_input":"2026-09-03T13:19:10.809261Z","iopub.status.busy":"2026-09-03T13:19:10.809015Z","iopub.status.idle":"2026-09-03T13:19:10.814006Z","shell.execute_reply":"2026-09-03T13:19:10.81343Z"},"papermill":{"duration":0.040041,"end_time":"2026-09-03T13:19:10.815585+00:00","exception":false,"start_time":"2026-09-03T13:19:10.775544+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["S_STATIC = (\n","    G_OBS\n","    @ SIGMA_A\n","    @ G_OBS.T\n","    + R_OBS\n",")\n","\n","K_STATIC = (\n","    SIGMA_A\n","    @ G_OBS.T\n","    @ np.linalg.pinv(\n","        S_STATIC\n","    )\n",")\n","\n","\n","def static_latent_inverse(\n","    bobs\n","):\n","    return (\n","        (np.asarray(\n","            bobs,\n","            dtype=float\n","        ) - C_OBS[None, :])\n","        @ K_STATIC.T\n","    )"]},{"cell_type":"markdown","id":"d869b1bb","metadata":{"papermill":{"duration":0.033514,"end_time":"2026-09-03T13:19:10.883726+00:00","exception":false,"start_time":"2026-09-03T13:19:10.850212+00:00","status":"completed"},"tags":[]},"source":["## 31. Latent-state Kalman filter"]},{"cell_type":"code","execution_count":38,"id":"c14eac54","metadata":{"execution":{"iopub.execute_input":"2026-09-03T13:19:10.950961Z","iopub.status.busy":"2026-09-03T13:19:10.950616Z","iopub.status.idle":"2026-09-03T13:19:10.958708Z","shell.execute_reply":"2026-09-03T13:19:10.957919Z"},"papermill":{"duration":0.042971,"end_time":"2026-09-03T13:19:10.960244+00:00","exception":false,"start_time":"2026-09-03T13:19:10.917273+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def latent_kalman_filter(\n","    bobs,\n","):\n","    bobs = np.asarray(\n","        bobs,\n","        dtype=float\n","    )\n","\n","    n = len(bobs)\n","\n","    a_pred = np.zeros(\n","        (n, K)\n","    )\n","\n","    a_filt = np.zeros(\n","        (n, K)\n","    )\n","\n","    P_pred_store = np.zeros(\n","        (n, K, K)\n","    )\n","\n","    P_filt_store = np.zeros(\n","        (n, K, K)\n","    )\n","\n","    innovation = np.zeros(\n","        (n, K)\n","    )\n","\n","    innovation_nis = np.zeros(\n","        n\n","    )\n","\n","    a_prev = np.zeros(K)\n","    P_prev = SIGMA_A.copy()\n","\n","    I = np.eye(K)\n","\n","    for t in range(n):\n","        if t == 0:\n","            ap = a_prev\n","            Pp = P_prev\n","        else:\n","            ap = (\n","                F_GEN @ a_prev\n","            )\n","\n","            Pp = (\n","                F_GEN\n","                @ P_prev\n","                @ F_GEN.T\n","                + Q_GEN\n","            )\n","\n","        nu = (\n","            bobs[t]\n","            - C_OBS\n","            - G_OBS @ ap\n","        )\n","\n","        S = (\n","            G_OBS\n","            @ Pp\n","            @ G_OBS.T\n","            + R_OBS\n","        )\n","\n","        Sinv = np.linalg.pinv(\n","            S\n","        )\n","\n","        Kgain = (\n","            Pp\n","            @ G_OBS.T\n","            @ Sinv\n","        )\n","\n","        af = (\n","            ap\n","            + Kgain @ nu\n","        )\n","\n","        # Joseph-form covariance update.\n","        Aupdate = (\n","            I\n","            - Kgain @ G_OBS\n","        )\n","\n","        Pf = (\n","            Aupdate\n","            @ Pp\n","            @ Aupdate.T\n","            + Kgain\n","            @ R_OBS\n","            @ Kgain.T\n","        )\n","\n","        Pf = 0.5*(Pf+Pf.T)\n","\n","        a_pred[t] = ap\n","        a_filt[t] = af\n","\n","        P_pred_store[t] = Pp\n","        P_filt_store[t] = Pf\n","\n","        innovation[t] = nu\n","\n","        innovation_nis[t] = float(\n","            nu\n","            @ Sinv\n","            @ nu\n","        ) / K\n","\n","        a_prev = af\n","        P_prev = Pf\n","\n","    return {\n","        \"a_pred\": a_pred,\n","        \"a_filt\": a_filt,\n","        \"P_pred\": P_pred_store,\n","        \"P_filt\": P_filt_store,\n","        \"innovation\": innovation,\n","        \"innovation_nis_per_dim\": innovation_nis,\n","    }"]},{"cell_type":"markdown","id":"fabaa090","metadata":{"papermill":{"duration":0.032243,"end_time":"2026-09-03T13:19:11.023582+00:00","exception":false,"start_time":"2026-09-03T13:19:10.991339+00:00","status":"completed"},"tags":[]},"source":["# Part K — Held-out null forecast decomposition\n","\n","The cleanest decomposition uses the six independent null validation trajectories because their\n","physical truth lies exactly in the frozen rank-\\(K\\) physical subspace.\n","\n","For issue frame \\(t\\), define:\n","\n","### M0 — image-ROM forecast\n","\\[\n","\\hat b_{t+h}=F_{\\rm img}^h b_t,\n","\\qquad\n","\\hat D^{img}_{t+h}\n","=\n","\\mu_{\\rm img}+\\Phi_{\\rm img}\\hat b_{t+h}.\n","\\]\n","\n","### M1 — static inverse + latent propagation\n","\\[\n","\\hat a_t^{static}\n","=\n","\\Sigma_aG^T(G\\Sigma_aG^T+R)^{-1}(b_t-c),\n","\\]\n","then\n","\\[\n","\\hat a_{t+h}=F_{\\rm gen}^h\\hat a_t^{static}.\n","\\]\n","\n","### M2 — latent Kalman + propagation\n","\\[\n","\\hat a_{t|t}^{KF}\n","\\rightarrow\n","F_{\\rm gen}^h\\hat a_{t|t}^{KF}.\n","\\]\n","\n","### M3 — oracle current state + propagation\n","\\[\n","a_t^{true}\n","\\rightarrow\n","F_{\\rm gen}^h a_t^{true}.\n","\\]\n","\n","M3 still cannot know future process noise, so its error is the empirical **dynamics/process floor**\n","for this \\(h=3\\) prediction problem."]},{"cell_type":"markdown","id":"aab3eeba","metadata":{"papermill":{"duration":0.030962,"end_time":"2026-09-03T13:19:11.086259+00:00","exception":false,"start_time":"2026-09-0