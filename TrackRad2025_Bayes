":false,"start_time":"2026-09-03T13:31:59.91602+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def base_prior_residual_and_covariance(\n","    run,\n","    t,\n","):\n","    a_pred = (\n","        run[\n","            \"base_kf\"\n","        ][\n","            \"a_pred\"\n","        ][t]\n","    )\n","\n","    P_pred = (\n","        run[\n","            \"base_kf\"\n","        ][\n","            \"P_pred\"\n","        ][t]\n","    )\n","\n","    residual = (\n","        run[\n","            \"bobs\"\n","        ][t]\n","        - C_OBS\n","        - G_OBS @ a_pred\n","    )\n","\n","    S0 = (\n","        G_OBS\n","        @ P_pred\n","        @ G_OBS.T\n","        + R_OBS\n","    )\n","\n","    S0 = 0.5*(\n","        S0+S0.T\n","    )\n","\n","    scale = float(\n","        np.trace(S0)\n","        / S0.shape[0]\n","    )\n","\n","    S0 += max(\n","        CFG.covariance_jitter_fraction\n","        * max(scale, 1e-12),\n","        1e-12\n","    ) * np.eye(\n","        S0.shape[0]\n","    )\n","\n","    return (\n","        residual,\n","        S0,\n","    )\n","\n","\n","def stable_inverse(A):\n","    A = 0.5*(\n","        np.asarray(\n","            A,\n","            dtype=float\n","        )\n","        + np.asarray(\n","            A,\n","            dtype=float\n","        ).T\n","    )\n","\n","    return np.linalg.pinv(\n","        A\n","    )"]},{"cell_type":"markdown","id":"90bb9e49","metadata":{"papermill":{"duration":0.037919,"end_time":"2026-09-03T13:32:00.041726+00:00","exception":false,"start_time":"2026-09-03T13:32:00.003807+00:00","status":"completed"},"tags":[]},"source":["## 44. Generalized least-squares fit of \\(g_z,d_z\\) on four trajectories"]},{"cell_type":"code","execution_count":51,"id":"e25ce2e4","metadata":{"execution":{"iopub.execute_input":"2026-09-03T13:32:00.119169Z","iopub.status.busy":"2026-09-03T13:32:00.118755Z","iopub.status.idle":"2026-09-03T13:32:00.189769Z","shell.execute_reply":"2026-09-03T13:32:00.18871Z"}