 8.937842                   11.501264  \n","4                       8.880080                   11.844029  \n","5                       8.709323                   11.915109  "]},"metadata":{},"output_type":"display_data"}],"source":["def displacement_epe(\n","    Dpred,\n","    Dtarget,\n","    roi_mask=None,\n","):\n","    A = np.asarray(\n","        Dpred,\n","        dtype=float\n","    ).reshape(2, H, W)\n","\n","    B = np.asarray(\n","        Dtarget,\n","        dtype=float\n","    ).reshape(2, H, W)\n","\n","    e = np.sqrt(\n","        (A[0]-B[0])**2\n","        + (A[1]-B[1])**2\n","    )\n","\n","    if roi_mask is None:\n","        return float(\n","            np.mean(e)\n","        )\n","\n","    return float(\n","        np.mean(\n","            e[roi_mask]\n","        )\n","    )\n","\n","\n","ceiling_rows = []\n","\n","for r in obs_val_runs:\n","    for t in range(\n","        len(r[\"Dobs\"])\n","    ):\n","        ceiling_rows.append({\n","            \"sequence_index\": r[\"index\"],\n","            \"frame\": t,\n","            \"global_hs_to_truth_epe_mm\": displacement_epe(\n","                r[\"Dobs\"][t],\n","                r[\"Dtrue\"][t],\n","                roi_mask=None,\n","            ),\n","            \"roi_hs_to_truth_epe_mm\": displacement_epe(\n","                r[\"Dobs\"][t],\n","                r[\"Dtrue\"][t],\n","                roi_mask=ROI_PIXEL_MASK,\n","            ),\n","        })\n","\n","\n","null_observation_ceiling = pd.DataFrame(\n","    ceiling_rows\n",")\n","\n","null_ceiling_by_sequence = (\n","    null_observation_ceiling\n","    .groupby(\n","        \"sequence_index\",\n","        as_index=False\n","    )\n","    .agg(\n","        median_global_hs_to_truth_epe_mm=(\n","            \"global_hs_to_truth_epe_mm\",\n","            \"median\"\n","        ),\n","        median_roi_hs_to_truth_epe_mm=(\n","            \"roi_hs_to_truth_epe_mm\",\n","            \"median\"\n","        ),\n","        p90_roi_hs_to_t