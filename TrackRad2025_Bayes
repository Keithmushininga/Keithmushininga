n","for r in null_runs:\n","    r[\"bobs\"] = image_scores(\n","        r[\"Dobs\"]\n","    )\n","\n","\n","def fit_multisequence_dynamics(\n","    score_sequences,\n","):\n","    X0 = np.vstack([\n","        s[:-1]\n","        for s in score_sequences\n","    ])\n","\n","    X1 = np.vstack([\n","        s[1:]\n","        for s in score_sequences\n","    ])\n","\n","    Fm = np.linalg.solve(\n","        X0.T @ X0\n","        + 1e-5*np.eye(\n","            X0.shape[1]\n","        ),\n","        X0.T @ X1\n","    ).T\n","\n","    rad = float(\n","        np.max(\n","            np.abs(\n","                np.linalg.eigvals(Fm)\n","            )\n","        )\n","    )\n","\n","    if rad >= 0.995:\n","        Fm *= (\n","            0.995/rad\n","        )\n","\n","    eps = (\n","        X1\n","        - X0 @ Fm.T\n","    )\n","\n","    Qm = np.cov(\n","        eps,\n","        rowvar=False\n","    )\n","\n","    Qm = np.atleast_2d(\n","        Qm\n","    )\n","\n","    Qm = (\n","        0.5*(Qm+Qm.T)\n","        + 1e-8*np.eye(\n","            Qm.shape[0]\n","        )\n","    )\n","\n","    return Fm, Qm\n","\n","\n","F_IMG, Q_IMG = fit_multisequence_dynamics([\n","    r[\"bobs\"]\n","    for r in obs_cal_runs\n","])\n","\n","image_rom_audit = pd.DataFrame([{\n","    \"retained_energy_fraction\": IMG_RETAINED_ENERGY_FRACTION,\n","    \"rho_F_img\": float(\n","        np.max(\n","            np.abs(\n","                np.linalg.eigvals(F_IMG)\n","            )\n","        )\n","    ),\n","    \"real_vs_image_median_angle_deg\": float(\n","        np.degrees(\n","            np.median(\n","                principal_angles(\n","                    PHI_REAL,\n","                    PHI_IMG\n","                )\n","            )\n","        )\n","    ),\n","    \"real_vs_image_max_angle_deg\": float(\n","        np.degrees(\n","            np.max(\n","                principal_angles(\n","                    PHI_REAL,\n","                    PHI_IMG\n","                )\n","            )\n","        )\n","    ),\n","}])\n","\n","display(image_rom_audit)\n","\n","image_rom_audit.to_csv(\n","    TABLES / \"frozen_image_ROM_audit.csv\",\n","    index=False\n",")"]},{"cell_type":"markdown","id":"e08625e8","metadata":{"papermill":{"duration":0.05408,"end_time":"2026-09-03T13:19:09.612545+00:00","exception":false,"start_time":"2026-09-03T13:19:09.558465+00:00","status":"completed"},"tags":[]},"source":["# Part G — Observation ceiling\n","\n","For every null validation frame we compare the recovered Horn--Schunck field directly with\n","the known physical displacement:\n","\n","\\[\n","e^{HS}_t(x)\n","=\n","\\|D^{HS}_t(x)-D^{true}_t(x)\\|_2.\n","\\]\n","\n","If this error is already large relative to the forecast error, an adaptive ROM that simply\n","tracks \\(D^{HS}\\) cannot be expected to recover the physical truth."]},{"cell_type":"markdown","id":"0f5293af","metadata":{"papermill":{"duration":0.03014,"end_time":"2026-09-03T13:19:09.675307+00:00","exception":false,"start_time":"2026-09-03T13:19:09.645167+00:00","status":"completed"},"tags":[]},"source":["## 26. EPE helpers and held-out null observation ceiling"]},{"cell_type":"code","execution_count":33,"id":"8785e49b","metadata":{"execution":{"iopub.execute_input":"2026-09-03T13:19:09.738228Z","iopub.status.busy":"2026-09-03T13:19:09.737538Z","iopub.status.idle":"2026-09-03T13:19:10.027705Z","shell.execute_reply":"2026-09-03T13:19:10.026745Z"},"papermill":{"duration":0.323058,"end_time":"2026-09-03T13:19:10.029355+00:00","exception":false,"start_time":"2026-09-03T13:19:09.706297+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n"