terior_probability,\n","):\n","    pi = float(\n","        posterior_probability\n","    )\n","\n","    return float(\n","        np.clip(\n","            (\n","                pi\n","                - EVIDENCE_PROBABILITY_THRESHOLD\n","            )\n","            / max(\n","                1.0\n","                - EVIDENCE_PROBABILITY_THRESHOLD,\n","                CFG.probability_eps\n","            ),\n","            0.0,\n","            1.0,\n","        )\n","    )\n","\n","\n","def risk_limited_structural_action(\n","    posterior_probability,\n","    z_future_mean,\n","    z_future_variance,\n","    lambda_risk,\n","):\n","    gamma_evidence = (\n","        evidence_soft_weight(\n","            posterior_probability\n","        )\n","    )\n","\n","    evidence_action = float(\n","        gamma_evidence\n","        * z_future_mean\n","    )\n","\n","    effective_variance = float(\n","        z_future_variance\n","        + (\n","            CFG.rank_growth_rho\n","            ** (\n","                2*int(\n","                    CFG.forecast_horizon\n","                )\n","            )\n","        )\n","        * SIGMA_EPI2\n","    )\n","\n","    uncertainty_ratio = float(\n","        effective_variance\n","        / max(\n","            S_Z2_ACTION,\n","            CFG.probability_eps\n","        )\n","    )\n","\n","    alpha_risk = float(\n","        1.0\n","        / (\n","            1.0\n","            + float(\n","                lambda_risk\n","            )\n","            * uncertainty_ratio\n","        )\n","    )\n","\n","    unconstrained = float(\n","        alpha_risk\n","        * evidence_action\n","    )\n","\n","    action = float(\n","        np.clip(\n","            unconstrained,\n","            -ACTION_BOUND_B,\n","            ACTION_BOUND_B,\n","        )\n","    )\n","\n","    bound_active = bool(\n","        abs(\n","            unconstrained\n","        )\n","        > ACTION_BOUND_B\n","    )\n","\n","    return {\n","     