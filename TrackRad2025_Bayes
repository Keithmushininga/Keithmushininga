","\n","roi_weight /= max(\n","    float(np.max(roi_weight)),\n","    1e-12\n",")\n","\n","\n","def roi_weighted_orthogonal_field(\n","    seed,\n","    against,\n","    sigma=4.0,\n","):\n","    rng = np.random.default_rng(seed)\n","\n","    raw = np.stack([\n","        gaussian_filter(\n","            rng.normal(size=(H, W)),\n","            sigma=sigma\n","        ) * roi_weight,\n","        gaussian_filter(\n","            rng.normal(size=(H, W)),\n","            sigma=sigma\n","        ) * roi_weight,\n","    ])\n","\n","    v = raw.reshape(-1).astype(float)\n","\n","    A = np.asarray(\n","        against,\n","        dtype=float\n","    )\n","\n","    if A.ndim == 1:\n","        A = A[:, None]\n","\n","    if A.size:\n","        v = v - A @ (A.T @ v)\n","\n","    nrm = float(\n","        np.linalg.norm(v)\n","    )\n","\n","    if nrm < 1e-12:\n","        raise RuntimeError(\n","            \"Degenerate ROI-weighted direction.\"\n","        )\n","\n","    return v/nrm\n","\n","\n","psi_rotation = roi_weighted_orthogonal_field(\n","    CFG.seed+101,\n","    PHI_REAL\n",")\n","\n","psi_rank = roi_weighted_orthogonal_field(\n","    CFG.seed+102,\n","    np.column_stack([\n","        PHI_REAL,\n","        psi_rotation,\n","    ])\n",")\n","\n","psi_transient = roi_weighted_orthogonal_field(\n","    CFG.seed+103,\n","    np.column_stack([\n","        PHI_REAL,\n","        psi_rotation,\n","        psi_rank,\n","    ])\n",")\n","\n","direction_audit = pd.DataFrame({\n","    \"direction\": [\n","        \"rotation\",\n","        \"rank\",\n","        \"transient\",\n","    ],\n","    \"roi_rms\": [\n","        roi_mode_rms(psi_rotation),\n","        roi_mode_rms(psi_rank),\n","        roi_mode_rms(psi_transient),\n","    ],\n","    \"max_abs_projection_on_Phi_real\": [\n","        np.max(\n","            np.abs(\n","                PHI_REAL.T @ psi_rotation\n","            )\n","        ),\n","        np.max(\n","            np.abs(\n","                PHI_REAL.T @ psi_rank\n","            )\n","        ),\n","        np.max(\n","            np.abs(\n","                PHI_REAL.T @ psi_transient\n","            )\n","        ),\n","    ],\n","})\n","\n","display(direction_audit)\n","\n","direction_audit.to_csv(\n","    TABLES / \"frozen_v5_direction_audit.csv\",\n","    index=False\n",")"]},{"cell_type":"markdown","id":"8c660bd9","metadata":{"papermill":{"duration":0.049854,"end_time":"2026-09-03T13:10:00.897954+00:00","exception":false,"start_time":"2026-09-03T13:10:00.8481+00:00","status":"completed"},"tags":[]},"source":["## 22. Frozen simulator and exact v5 evaluation parameters"]},{"cell_type":"code","execution_count":29,"id":"3de2e423","metadata":{"execution":{"iopub.execute_input":"2026-09-03T13:10:00.962647Z","iopub.status.busy":"2026-09-03T13:10:00.962425Z","iopub.status.idle":"2026-09-03T13:10:00.983683Z","shell.execute_reply":"2026-09-03T13:10:00.983099Z"},"papermill":{"duration":0.050893,"end_time":"2026-09-03T13:10:00.985075+00:00","exception":false,"start_time":"2026-09-03T13:10:00.934182+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>family</th>\n","      <th>frozen_parameter</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>rotation_local</td>\n","      <td>14.0</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>rotation_severe</td>\n","      <td>70.0</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>rank_growth</td>\n","      <td>1.0</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>dynamic_F</td>\n","      <td>2.0</td>\n","    </tr>\n","    <tr>\n","      <th>4</th>\n","      <td>transient</td>\n","      <td>3.0</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["            family  frozen_parameter\n","0   rotation_local              14.0\n","1  rotation_severe              70.0\n","2      rank_growth               1.0\n","3        dynamic_F               2.0\n","4        transient               3.0"]},"metadata":{},"output_type":"display_data"}],"source":["def stable_cholesky(A):\n","    A = 0.5*(A+A.T)\n","    jitter = 1e-10\n","\n","    for _ in range(10):\n","        try:\n","            return np.linalg.cholesky(\n","                A + jitter*np.eye(A.shape[0])\n","            )\n","        except np.linalg.LinAlgError:\n","            jitter *= 10.0\n","\n","    raise np.linalg.LinAlgError(\n","        \"Could not stabilise covariance.\"\n","    )\n","\n","\n","L_SIGMA_A = stable_cholesky(SIGMA_A)\n","L_Q_GEN = stable_cholesky(Q_GEN)\n","QINV_GEN = np.linalg.pinv(Q_GEN)\n","\n","B_F = -F_GEN.copy()\n","\n","metric_sq_F = float(\n","    np.trace(\n","        QINV_GEN\n","        @ B_F\n","        @ SIGMA_A\n","        @ B_F.T\n","    )\n",")\n","\n","if metric_sq_F <= 1e-15:\n","    raise RuntimeError(\n","        \"Degenerate dynamic-F perturbation metric.\"\n","    )\n","\n","B_F_UNIT = B_F / np.sqrt(\n","    metric_sq_F\n",")\n","\n","\n","def F_changed_for_lambda(lambda_F):\n","    DeltaF = (\n","        np.sqrt(float(lambda_F))\n","        * B_F_UNIT\n","    )\n","\n","    F1 = F_GEN + DeltaF\n","\n","    rho = float(\n","        np.max(\n","            np.abs(\n","                np.linalg.eigvals(F1)\n","            )\n","        )\n","    )\n","\n","    actual = float(\n","        np.trace(\n","            QINV_GEN\n","            @ DeltaF\n","            @ SIGMA_A\n","            @ DeltaF.T\n","        )\n","    )\n","\n","    return F1, actual, rho\n","\n","\n","def simulate_stationary_scores(\n","    length,\n","    seed,\n","    onset,\n","    family=\"null\",\n","    lambda_F=None,\n","):\n","    rng = np.random.default_rng(seed)\n","\n","    a = np.zeros(\n","        (length, K),\n","        dtype=float\n","    )\n","\n","    a[0] = (\n","        L_SIGMA_A\n","        @ rng.normal(size=K)\n","    )\n","\n","    F_changed = None\n","\n","    if family == \"dynamic_F\":\n","        F_changed, _, rho = (\n","            F_changed_for_lambda(\n","                lambda_F\n","            )\n","        )\n","\n","        if rho >= 0.995:\n","            raise RuntimeError(\n","                f\"Unstable changed transition at lambda_F={lambda_F}.\"\n","            )\n","\n","    for t in range(1, length):\n","        F_t = (\n","            F_changed\n","            if (\n","                family == \"dynamic_F\"\n","                and t >= onset\n","            )\n","            else F_GEN\n","        )\n","\n","        a[t] = (\n","            F_t @ a[t-1]\n","            + L_Q_GEN\n","            @ rng.normal(size=K)\n","        )\n","\n","    return a\n","\n","\n","V5_PARAMETERS = {\n","    \"rotation_local\": CFG.v5_rotation_local_deg,\n","    \"rotation_severe\": CFG.v5_rotation_severe_deg,\n","    \"rank_growth\": CFG.v5_rank_growth_q,\n","    \"dynamic_F\": CFG.v5_dynamic_lambda_F,\n","    \"transient\": CFG.v5_transient_amplitude,\n","}\n","\n","\n","def controlled_displacement_sequence(\n","    family,\n","    parameter,\n","    length,\n","    onset,\n","    seed,\n","):\n","    score_family = (\n","        \"dynamic_F\"\n","        if family == \"dynamic_F\"\n","        else \"null\"\n","    )\n","\n","    a = simulate_stationary_scores(\n","        length=length,\n","        seed=seed,\n","        onset=onset,\n","        family=score_family,\n","        lambda_F=(\n","            parameter\n","            if family == \"dynamic_F\"\n","            else None\n","        ),\n","    )\n","\n","    Dbase = (\n","        D_REAL_MEAN[None, :]\n","        + a @ PHI_REAL.T\n","    )\n","\n","    Dtrue = Dbase.copy()\n","\n","    rng = np.random.default_rng(\n","        seed+90000\n","    )\n","\n","    if family in {\n","        \"rotation_local\",\n","        \"rotation_severe\",\n","    }:\n","        theta = np.deg2rad(\n","            float(parameter)\n","        )\n","\n","        delta_direction = (\n","            (np.cos(theta)-1.0)\n","            * PHI_REAL[:, K_ROT]\n","            + np.sin(theta)\n","            * psi_rotation\n","        )\n","\n","        Dtrue[onset:] += (\n","            a[onset:, K_ROT, None]\n","            * delta_direction[None, :]\n","        )\n","\n","    elif family == \"rank_growth\":\n","        q = float(parameter)\n","\n","        target_var = (\n","            q\n","            * float(\n","                SIGMA_A[\n","                    K_ROT,\n","                    K_ROT\n","                ]\n","            )\n","        )\n","\n","        rho_b = 0.92\n","\n","        innovation_sd = np.sqrt(\n","            max(\n","                target_var\n","                * (1.0-rho_b**2),\n","                1e-12\n","            )\n","        )\n","\n","        b = np.zeros(length)\n","\n","        for t in range(\n","            onset+1,\n","            length\n","        ):\n","            b[t] = (\n","                rho_b*b[t-1]\n","                + innovation_sd\n","                * rng.normal()\n","            )\n","\n","        Dtrue[onset:] += (\n","            b[onset:, None]\n","            * psi_rank[None, :]\n","        )\n","\n","    elif family == \"transient\":\n","        amp = (\n","            float(parameter)\n","            * np.sqrt(\n","                max(\n","                    SIGMA_A[\n","                        K_ROT,\n","                        K_ROT\n","                    ],\n","                    1e-12\n","                )\n","            )\n","        )\n","\n","        pulse = np.array(\n","            [0.60, 1.00, 0.60]\n","        )\n","\n","        for j, w in enumerate(\n","            pulse\n","        ):\n","            t = onset+j\n","\n","            if t < length:\n","                Dtrue[t] += (\n","                    amp*w\n","                    * psi_transient\n","                )\n","\n","    elif family in {\n","        \"dynamic_F\",\n","        \"null\",\n","    }:\n","        pass\n","\n","    else:\n","        raise ValueError(\n","            f\"Unknown family: {family}\"\n","        )\n","\n","    return Dtrue, Dbase, a\n","\n","\n","v5_parameter_table = pd.DataFrame([\n","    {\n","        \"family\": family,\n","        \"frozen_parameter\": value,\n","    }\n","    for family, value\n","    in V5_PARAMETERS.items()\n","])\n","\n","display(v5_parameter_table)\n","\n","v5_parameter_table.to_csv(\n","    TABLES / \"frozen_v5_evaluation_parameters.csv\",\n","    index=False\n",")"]},{"cell_type":"markdown","id":"02910a8d","metadata":{"papermill":{"duration":0.027101,"end_time":"2026-09-03T13:10:01.040616+00:00","exception":false,"start_time":"2026-09-03T13:10:01.013515+00:00","status":"completed"},"tags":[]},"source":["# Part E — Image formation and cache-aware sequence recovery\n","\n","The notebook first looks for the exact Safety-Cage v5 Horn--Schunck cache. If it is present\n","in the same Kaggle session it is reused; otherwise the sequence is regenerated."]},{"cell_type":"markdown","id":"c8de21d0","metadata":{"papermill":{"duration":0.027875,"end_time":"2026-09-03T13:10:01.096278+00:00","exception":false,"start_time":"2026-09-03T13:10:01.068403+00:00","status":"completed"},"tags":[]},"source":["## 23. Image rendering and Horn--Schunck recovery"]},{"cell_type":"code","execution_count":30,"id":"8dceb0ac","metadata":{"execution":{"iopub.execute_input":"2026-09-03T13:10:01.153046Z","iopub.status.busy":"2026-09-03T13:10:01.152401Z","iopub.status.idle":"2026-09-03T13:10:01.161952Z","shell.execute_reply":"2026-09-03T13:10:01.161406Z"},"papermill":{"duration":0.039438,"end_time":"2026-09-03T13:10:01.163315+00:00","exception":false,"start_time":"2026-09-03T13:10:01.123877+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["REFERENCE_IMAGE_SYNTH = (\n","    images_crop[REFERENCE_FRAME]\n","    .astype(float)\n",")\n","\n","\n","def warp_reference_scalar(\n","    reference,\n","    u,\n","    v,\n","    sign,\n","    order=1,\n","):\n","    yy, xx = np.meshgrid(\n","        np.arange(reference.shape[0]),\n","        np.arange(reference.shape[1]),\n","        indexing=\"ij\"\n","    )\n","\n","    src_y = yy-sign*v\n","    src_x = xx-sign*u\n","\n","    return map_coordinates(\n","        reference.astype(float),\n","        [src_y, src_x],\n","        order=order,\n","        mode=\"nearest\",\n","    )\n","\n","\n","def render_target_image(Dvec):\n","    flow = np.asarray(\n","        Dvec,\n","        dtype=float\n","    ).reshape(2, H, W)\n","\n","    return warp_reference_scalar(\n","        REFERENCE_IMAGE_SYNTH,\n","        flow[0],\n","        flow[1],\n","        sign=FLOW_SIGN,\n","        order=1,\n","    )\n","\n","\n","def render_target_mask(Dvec):\n","    flow = np.asarray(\n","        Dvec,\n","        dtype=float\n","    ).reshape(2, H, W)\n","\n","    return warp_reference_mask(\n","        reference_mask,\n","        flow[0],\n","        flow[1],\n","        sign=FLOW_SIGN,\n","    )\n","\n","\n","def recover_sequence_optical_flow(\n","    Dtrue,\n","    cache_key,\n","    v5_cache_key=None,\n","):\n","    expected_shape = (\n","        len(Dtrue),\n","        2,\n","        H,\n","        W,\n","    )\n","\n","    candidates = []\n","\n","    # Old v5 optical-flow caches used single-scale HS and are\n","    # scientifically incompatible with this pyramidal observation audit.\n","    # They are intentionally not reused.\n","\n","    candidates.append(\n","        IMAGE_CACHE\n","        / f\"{cache_key}_observed_flows.npy\"\n","    )\n","\n","    for cache_path in candidates:\n","        if cache_path.exists():\n","            arr = np.load(\n","                cache_path\n","            )\n","\n","            if arr.shape == expected_shape:\n","                print(\n","                    \"Loaded OF cache:\",\n","                    cache_path\n","                )\n","                return arr\n","\n","    flows = np.zeros(\n","        expected_shape,\n","        dtype=np.float32\n","    )\n","\n","    t0 = time.time()\n","\n","    for t in range(\n","        len(Dtrue)\n","    ):\n","        target = render_target_image(\n","            Dtrue[t]\n","        )\n","\n","        u_raw, v_raw = pyramidal_horn_schunck(\n","            REFERENCE_IMAGE_SYNTH,\n","            target,\n","            alpha=PYR_ALPHA,\n","            n_iter_per_warp=CFG.pyramid_hs_iterations_per_warp,\n","            n_levels=PYR_LEVELS,\n","            n_warps=PYR_WARPS,\n","        )\n","\n","        flows[t, 0] = (\n","            PYR_ORIENTATION_SIGN\n","            * u_raw\n","        )\n","\n","        flows[t, 1] = (\n","            PYR_ORIENTATION_SIGN\n","            * v_raw\n","        )\n","\n","        if (\n","            (t+1) % 20 == 0\n","            or t == len(Dtrue)-1\n","        ):\n","            print(\n","                cache_key,\n","                f\"{t+1}/{len(Dtrue)}\"\n","            )\n","\n","    new_cache = (\n","        IMAGE_CACHE\n","        / f\"{cache_key}_observed_flows.npy\"\n","    )\n","\n","    np.save(\n","        new_cache,\n","        flows\n","    )\n","\n","    print(\n","        cache_key,\n","        \"OF runtime:\",\n","        f\"{time.time()-t0:.1f}s\"\n","    )\n","\n","    return flows"]},{"cell_type":"markdown","id":"84138941","metadata":{"papermill":{"duration":0.027014,"end_time":"2026-09-03T13:10:01.217809+00:00","exception":false,"start_time":"2026-09-03T13:10:01.190795+00:00","status":"completed"},"tags":[]},"source":["## 24. Recreate only the v5 null sequences needed for observation training/validation"]},{"cell_type":"code","