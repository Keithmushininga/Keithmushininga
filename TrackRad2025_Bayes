_type":"stream","text":["G shape: (12, 12)\n","Intercept norm: 79.92547875087244\n"]}],"source":["N_G_TRAIN = int(\n","    CFG.observation_G_train_sequences\n",")\n","\n","if not (\n","    1 <= N_G_TRAIN\n","    < len(obs_cal_runs)\n","):\n","    raise ValueError(\n","        \"Need at least one held-out observation-calibration sequence for R.\"\n","    )\n","\n","G_train_runs = (\n","    obs_cal_runs[\n","        :N_G_TRAIN\n","    ]\n",")\n","\n","R_cal_runs = (\n","    obs_cal_runs[\n","        N_G_TRAIN:\n","    ]\n",")\n","\n","A_train = np.vstack([\n","    r[\"atrue\"]\n","    for r in G_train_runs\n","])\n","\n","B_train = np.vstack([\n","    r[\"bobs\"]\n","    for r in G_train_runs\n","])\n","\n","X_aug = np.column_stack([\n","    A_train,\n","    np.ones(\n","        len(A_train)\n","    )\n","])\n","\n","reg = np.eye(\n","    K+1\n",")\n","\n","# Do not penalize the intercept.\n","reg[-1, -1] = 0.0\n","\n","W_obs = np.linalg.solve(\n","    X_aug.T @ X_aug\n","    + CFG.observation_ridge*reg,\n","    X_aug.T @ B_train,\n",")\n","\n","# B = A @ G.T + c\n","G_OBS = W_obs[\n","    :K, :\n","].T\n","\n","C_OBS = W_obs[\n","    -1, :\n","]\n","\n","B_train_hat = (\n","    A_train @ G_OBS.T\n","    + C_OBS[None, :]\n",")\n","\n","train_residual = (\n","    B_train-B_train_hat\n",")\n","\n","train_r2 = []\n","\n","for j in range(K):\n","    y = B_train[:, j]\n","    yh = B_train_hat[:, j]\n","\n","    denom = float(\n","        np.sum(\n","            (y-np.mean(y))**2\n","        )\n","    )\n","\n","    r2 = (\n","        1.0\n","        - float(\n","            np.sum(\n","                (y-yh)**2\n","            )\n","        )\n","        / max(\n","            denom,\n","            1e-12\n","        )\n","    )\n","\n","    train_r2.append(r2)\n","\n","print(\n","    \"G shape:\",\n","    G_OBS.shape\n",")\n","\n","print(\n","    \"Intercept norm:\",\n","    np.linalg.norm(C_OBS)\n",")"]},{"cell_type":"markdown","id":"95ed4098","metadata":{"papermill":{"d