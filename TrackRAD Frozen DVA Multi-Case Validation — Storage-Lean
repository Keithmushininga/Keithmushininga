","    values,\n","    statistic=\"mean\",\n","):\n","    x = np.asarray(\n","        values,\n","        dtype=float\n","    )\n","\n","    x = x[\n","        np.isfinite(\n","            x\n","        )\n","    ]\n","\n","    if len(\n","        x\n","    ) == 0:\n","        return (\n","            np.nan,\n","            np.nan,\n","        )\n","\n","    rng = np.random.default_rng(\n","        CCFG.bootstrap_seed\n","    )\n","\n","    vals = np.empty(\n","        CCFG.bootstrap_reps,\n","        dtype=float\n","    )\n","\n","    for b in range(\n","        CCFG.bootstrap_reps\n","    ):\n","        sample = rng.choice(\n","            x,\n","            size=len(\n","                x\n","            ),\n","            replace=True,\n","        )\n","\n","        if statistic == \"median\":\n","            vals[b] = np.median(\n","                sample\n","            )\n","        else:\n","            vals[b] = np.mean(\n","                sample\n","            )\n","\n","    alpha = (\n","        1.0\n","        - CCFG.confidence_level\n","    )\n","\n","    return (\n","        float(\n","            np.quantile(\n","                vals,\n","                alpha/2\n","            )\n","        ),\n","        float(\n","            np.quantile(\n","                vals,\n","                1-alpha/2\n","            )\n","        ),\n","    )\n","\n","\n","def exact_binomial_ci(\n","    successes,\n","    total,\n","):\n","    successes = int(\n","        successes\n","    )\n","\n","    total = int(\n","        total\n","    )\n","\n","    if total <= 0:\n","        return (\n","            np.nan,\n","            np.nan,\n","        )\n","\n","    alpha = (\n","        1.0\n","        - CCFG.confidence_level\n","    )\n","\n","    if successes == 0:\n","        lo = 0.0\n","    else:\n","        lo = float(\n","            beta.ppf(\n","                alpha/2,\n","                successes,\n","                total-successes+1,\n","            )\n"