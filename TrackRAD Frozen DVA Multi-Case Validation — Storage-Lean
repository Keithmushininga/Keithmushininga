hort cases.\"\n","    )\n","\n","BATCH_FIRST_INDEX = BATCH_START\n","BATCH_LAST_INDEX = BATCH_STOP - 1\n","\n","BATCH_ID = (\n","    f\"batch_{BATCH_FIRST_INDEX:03d}_\"\n","    f\"{BATCH_LAST_INDEX:03d}\"\n",")\n","\n","selection = pd.DataFrame({\n","    \"case_id\": ALL_DISCOVERED_CASES\n","})\n","\n","selection[\"development_case\"] = selection[\n","    \"case_id\"\n","].isin(\n","    CCFG.development_case_ids\n",")\n","\n","selection[\"explicit_exclusion\"] = selection[\n","    \"case_id\"\n","].isin(\n","    CCFG.exclude_case_ids\n",")\n","\n","selection[\"primary_target\"] = selection[\n","    \"case_id\"\n","].isin(\n","    PRIMARY_TARGET_CASES\n",")\n","\n","selection[\"scheduled_this_run\"] = selection[\n","    \"case_id\"\n","].isin(\n","    CASES_THIS_RUN\n",")\n","\n","display(selection)\n","\n","selection.to_csv(\n","    SUMMARY_ROOT\n","    / f\"{BATCH_ID}_case_selection.csv\",\n","    index=False\n",")\n","\n","BATCH_MANIFEST = {\n","    \"batch_id\": BATCH_ID,\n","    \"batch_start\": BATCH_START,\n","    \"batch_stop_exclusive\": BATCH_STOP,\n","    \"batch_size_requested\": BATCH_SIZE,\n","    \"n_cases_this_run\": len(CASES_THIS_RUN),\n","    \"cases_this_run\": CASES_THIS_RUN,\n","    \"development_cases_excluded\": list(\n","        CCFG.development_case_ids\n","    ),\n","    \"explicit_exclusions\": list(\n","        CCFG.exclude_case_ids\n","    ),\n","    \"n_all_discovered_cases\": len(\n","        ALL_DISCOVERED_CASES\n","    ),\n","    \"n_primary_target_cases\": len(\n","        PRIMARY_TARGET_CASES\n","    ),\n","}\n","\n","(\n","    SUMMARY_ROOT\n","    / f\"{BATCH_ID}_manifest.json\"\n",").write_text(\n","    json.dumps(\n","        BATCH_MANIFEST,\n","        indent=2\n","    ),\n","    encoding=\"utf-8\"\n",")\n","\n","print()\n","print(\"=\"*72)\n","print(\"THIS KAGGLE BACKGROUND BATCH\")\n","print(\"=\"*72)\n","print(\"Batch ID:\", BATCH_ID)\n","print(\"Independent cohort cases:\", len(PRIMARY_TARGET_CASES))\n","print(\"Cases sched